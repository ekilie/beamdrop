{
  "type": "excalidraw",
  "version": 2,
  "source": "beamdrop-diagram",
  "elements": [
    {
      "id": "internet",
      "type": "rectangle",
      "x": 400,
      "y": 20,
      "width": 300,
      "height": 60,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "text": "Internet / Clients\n(Browsers, S3 clients, cURL)"
    },
    {
      "id": "tls_boundary",
      "type": "rectangle",
      "x": 400,
      "y": 100,
      "width": 300,
      "height": 20,
      "strokeColor": "#ff0000",
      "backgroundColor": "#ffffff",
      "text": "TLS Boundary"
    },
    {
      "id": "reverse_proxy",
      "type": "rectangle",
      "x": 400,
      "y": 140,
      "width": 300,
      "height": 60,
      "strokeColor": "#000000",
      "backgroundColor": "#e0e0e0",
      "text": "Reverse Proxy (Caddy/Nginx)\nTLS termination"
    },
    {
      "id": "app_boundary",
      "type": "rectangle",
      "x": 400,
      "y": 220,
      "width": 300,
      "height": 20,
      "strokeColor": "#ff0000",
      "backgroundColor": "#ffffff",
      "text": "Application Boundary"
    },
    {
      "id": "beamdrop_server",
      "type": "rectangle",
      "x": 250,
      "y": 260,
      "width": 500,
      "height": 320,
      "strokeColor": "#000000",
      "backgroundColor": "#f0f8ff",
      "text": "Beamdrop Server (Go)\n\n- Middleware: Rate Limiter → CORS → Security Headers → Auth → Metrics\n- Web UI (React SPA)\n- File Management API\n- S3-compatible API\n- Shareable Links API\n- Health Probes\n- WebSocket / Metrics"
    },
    {
      "id": "data_boundary",
      "type": "rectangle",
      "x": 250,
      "y": 600,
      "width": 500,
      "height": 20,
      "strokeColor": "#ff0000",
      "backgroundColor": "#ffffff",
      "text": "Data Boundary"
    },
    {
      "id": "storage_pkg",
      "type": "rectangle",
      "x": 180,
      "y": 640,
      "width": 140,
      "height": 100,
      "strokeColor": "#000000",
      "backgroundColor": "#fff0f0",
      "text": "Storage Package\n- BucketManager\n- ObjectManager\n- AtomicWriter\n- LockManager"
    },
    {
      "id": "sqlite_db",
      "type": "rectangle",
      "x": 350,
      "y": 640,
      "width": 140,
      "height": 100,
      "strokeColor": "#000000",
      "backgroundColor": "#fff0f0",
      "text": "SQLite DB\n- API keys\n- Shareable links\n- Presigned URLs\n- Stats"
    },
    {
      "id": "crypto_pkg",
      "type": "rectangle",
      "x": 520,
      "y": 640,
      "width": 140,
      "height": 100,
      "strokeColor": "#000000",
      "backgroundColor": "#fff0f0",
      "text": "Crypto Package\n- HMAC-SHA256 signing\n- Signature verification\n- Constant-time comparison"
    },
    {
      "id": "filesystem",
      "type": "rectangle",
      "x": 200,
      "y": 780,
      "width": 140,
      "height": 60,
      "strokeColor": "#000000",
      "backgroundColor": "#e0ffe0",
      "text": "Filesystem\nshared-dir/"
    },
    {
      "id": "sqlite_file",
      "type": "rectangle",
      "x": 450,
      "y": 780,
      "width": 140,
      "height": 60,
      "strokeColor": "#000000",
      "backgroundColor": "#e0ffe0",
      "text": "SQLite File\nbeamdrop.db"
    },
    {
      "id": "arrow1",
      "type": "arrow",
      "startBinding": {"elementId": "internet"},
      "endBinding": {"elementId": "tls_boundary"},
      "points": [[550, 80], [550, 100]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow2",
      "type": "arrow",
      "startBinding": {"elementId": "tls_boundary"},
      "endBinding": {"elementId": "reverse_proxy"},
      "points": [[550, 120], [550, 140]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow3",
      "type": "arrow",
      "startBinding": {"elementId": "reverse_proxy"},
      "endBinding": {"elementId": "app_boundary"},
      "points": [[550, 200], [550, 220]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow4",
      "type": "arrow",
      "startBinding": {"elementId": "app_boundary"},
      "endBinding": {"elementId": "beamdrop_server"},
      "points": [[550, 240], [550, 260]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow5",
      "type": "arrow",
      "startBinding": {"elementId": "beamdrop_server"},
      "endBinding": {"elementId": "data_boundary"},
      "points": [[550, 580], [550, 600]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow6",
      "type": "arrow",
      "startBinding": {"elementId": "data_boundary"},
      "endBinding": {"elementId": "storage_pkg"},
      "points": [[250, 620], [250, 640]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow7",
      "type": "arrow",
      "startBinding": {"elementId": "data_boundary"},
      "endBinding": {"elementId": "sqlite_db"},
      "points": [[420, 620], [420, 640]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow8",
      "type": "arrow",
      "startBinding": {"elementId": "data_boundary"},
      "endBinding": {"elementId": "crypto_pkg"},
      "points": [[590, 620], [590, 640]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow9",
      "type": "arrow",
      "startBinding": {"elementId": "storage_pkg"},
      "endBinding": {"elementId": "filesystem"},
      "points": [[250, 740], [270, 780]],
      "strokeColor": "#000000"
    },
    {
      "id": "arrow10",
      "type": "arrow",
      "startBinding": {"elementId": "sqlite_db"},
